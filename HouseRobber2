class Solution(object):

  def rob(self, nums):
    """:type nums: List[int]

    :rtype: int
    """
    n = len(nums)
    if n == 0:
      return 0
    if n == 1:
      return nums[0]
    if n == 2:
      return max(nums[0], nums[1])

    # Case 1: Rob from index 0 to n-2 (exclude the last house)
    prev2 = 0
    prev1 = 0
    for i in range(n - 1):
      current = max(prev1, prev2 + nums[i])
      prev2 = prev1
      prev1 = current
    max1 = prev1

    # Case 2: Rob from index 1 to n-1 (exclude the first house)
    prev2 = 0
    prev1 = 0
    for i in range(1, n):
      current = max(prev1, prev2 + nums[i])
      prev2 = prev1
      prev1 = current
    max2 = prev1

    # Return the maximum of both scenarios
    return max(max1, max2)
