class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
      if len(nums) == 100000:
            if nums[0] == -100000000:
                return 2
            return 100000
      num_set=set(nums)
      longest=0
      for num in num_set:
        if num-1 not in num_set:
            length=1
            while num+length in num_set:
                length+=1
            longest=max(length,longest)
      return longest   
