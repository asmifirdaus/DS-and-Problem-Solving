class Solution:
    def reverse(self, x: int) -> int:
        num=0
        org=x
        x=abs(x)
        if org<=-2**31 or org>=2**31-1:
            return 0
        while(x>0):
            rem=x%10
            x=x//10
            print(rem,x)
            num=num*10+rem
            print(num)
        if org<0:
            res= -abs(num) 
        else:
            res= num
        return res if -2**31<res<2**31-1 else 0


