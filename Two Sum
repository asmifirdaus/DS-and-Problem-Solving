class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        d=dict()
        # print(d)
        for i in range(0,len(nums)):
            if(nums[i] in d.keys()):
                return list([i,d[nums[i]]])
            d[target-nums[i]]=i
